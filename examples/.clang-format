---
Language: Cpp
BasedOnStyle: Google
ColumnLimit: 200
DerivePointerAlignment: false
PointerAlignment: Left
# Google include order: related header, C system, C++ standard library, other libraries, this project.
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<(sys/|arpa/|netinet/|net/)?[a-z0-9_]+\.h>$'
    Priority: 1
    CaseSensitive: true
  - Regex: '^<[a-z0-9_]+>$'
    Priority: 2
    CaseSensitive: true
  - Regex: '^<.*>$'
    Priority: 3
  - Regex: '.*'
    Priority: 4
